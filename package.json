{
  "name": "shopfix-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:web": "tsc -b && vite build",
    "cap:sync": "bun run build && bunx --bun cap sync",
